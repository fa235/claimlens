{
    "family": "claimlens-frontend",
    "networkMode": "awsvpc",
    "cpu": "256",
    "memory": "512",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ClaimLensECSExecutionRole",
    "taskRoleArn": null,
    "containerDefinitions": [
        {
            "name": "Main",
            "image": "{{ACCOUNT_ID}}.dkr.ecr.{{REGION}}.amazonaws.com/claimlens-frontend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/claimlens-frontend",
                    "awslogs-region": "{{REGION}}",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ]
}
