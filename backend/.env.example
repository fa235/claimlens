# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
# Quoted so that `set -a; source .env` works in a shell, not just in pydantic.
APP_NAME="ClaimLens API"
DEBUG=false

# ── LLM provider (color/model vision + repair-cost text) ──────────────────────
# "openai"  → GPT-4o for both vision and text (works immediately)
# "bedrock" → Qwen via AWS Bedrock (needs on-demand quota)
LLM_PROVIDER=openai

# ── Per-step provider overrides ───────────────────────────────────────────────
# Each step can run on its own provider. "auto" means "use LLM_PROVIDER".
#
# Vision / damage detection — the model MUST be multimodal.
# "fireworks" → FIREWORKS_VISION_MODEL (Qwen3.8-Flash-Next) instead of GPT-4o.
VISION_LLM_PROVIDER=auto
#
# Cost estimation — text-only, so it can use a cheaper model.
# "fireworks" → FIREWORKS_COST_MODEL (GPT-OSS).
COST_LLM_PROVIDER=auto
#
# To run the whole pipeline on Fireworks open weights:
#   VISION_LLM_PROVIDER=fireworks
#   COST_LLM_PROVIDER=fireworks
# Then OPENAI_API_KEY is no longer needed.

# ── AWS Bedrock — Qwen models ─────────────────────────────────────────────────
BEDROCK_VISION_MODEL_ID=qwen.qwen3-vl-235b-a22b
BEDROCK_COST_MODEL_ID=qwen.qwen3-32b-v1:0

# ── Damage detection (YOLO boxes / masks) ─────────────────────────────────────
# "huggingface" → Naiscorp/car-damage-detection, pretrained 7-class model.
#                 Use this until our own YOLOv8 is trained on CarDD via SageMaker.
# "yolo"        → our fine-tuned YOLOv8 weights (set YOLO_WEIGHTS below)
DAMAGE_DETECTOR=huggingface
HF_DAMAGE_MODEL=Naiscorp/car-damage-detection
DAMAGE_CONF_THRESHOLD=0.5

# Save an annotated overlay (boxes + masks + labels) for each analyzed image.
# Only works with the cardamage model (DAMAGE_DETECTOR=huggingface).
SAVE_ANNOTATED=false

# ── Analysis mode ─────────────────────────────────────────────────────────────
# "inline" — run vision + cost directly in ClaimLens (default, self-contained).
# "agents" — delegate to the Agentex multi-agent orchestrator. Requires the
#            Agentex stack + claim-analyzer agent to be running.
ANALYSIS_MODE=inline
AGENTEX_BASE_URL=http://localhost:5003
AGENTEX_AGENT_NAME=claim-analyzer

# ── Review threshold ──────────────────────────────────────────────────────────
# Claims whose damage confidence is below this fraction are flagged
# needs_human_review.
REVIEW_CONFIDENCE_THRESHOLD=0.6

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated frontend origins. Add the deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── AWS credentials ───────────────────────────────────────────────────────────
# Leave empty on ECS/SageMaker — IAM task role is used automatically
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── OpenAI (used when LLM_PROVIDER=openai) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_COST_MODEL=gpt-4o

# ── Fireworks AI (used when *_LLM_PROVIDER=fireworks) ─────────────────────────
# Key from https://app.fireworks.ai/settings/users/api-keys
# Served over an OpenAI-compatible API, so no extra Python dependency.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Vision / damage detection — MUST be a multimodal model.
# Verified working on serverless: qwen3p8-max, qwen3p8-2p4t-a95b, kimi-k3.
# qwen3p8-flash-next-nvfp4 is NOT on serverless (404); it needs an on-demand
# deployment, then reference it as "<model-id>#<deployment-name>".
FIREWORKS_VISION_MODEL=accounts/fireworks/models/qwen3p8-max
# Reasoning VLMs need a big budget: qwen3p8-max produced no JSON at 2048 or
# 4096 and needs 8192. kimi-k3 works at 4096.
FIREWORKS_VISION_MAX_TOKENS=8192

# Cost estimation. GPT-OSS is text-only — fine here, not for vision.
# Swap in accounts/fireworks/models/gpt-oss-20b for a cheaper/faster run, or
# reuse qwen3p8-flash-next-nvfp4 to run both steps on one model.
FIREWORKS_COST_MODEL=accounts/fireworks/models/gpt-oss-120b
# Reasoning tokens count toward this budget — too low truncates the JSON.
FIREWORKS_COST_MAX_TOKENS=2048

# Applies to both steps.
# Reasoning depth: none | low | medium | high ("none" omits the parameter).
FIREWORKS_REASONING_EFFORT=low
# Constrain decoding to valid JSON. Set false if a model rejects it.
FIREWORKS_JSON_MODE=true

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" for development, "s3" for production
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=claimlens-images

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://claimlens:claimlens@localhost:5432/claimlens

# ── YOLOv8 ───────────────────────────────────────────────────────────────────
# Default: downloads pretrained yolov8n.pt on first run
# After SageMaker training: set to weights/damage_detector.pt
YOLO_WEIGHTS=yolov8n.pt
