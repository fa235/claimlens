# ── Copy this file to .env and fill in your values ───────────────────────────
# cp .env.example .env

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ClaimLens API
DEBUG=false

# ── LLM provider (color/model vision + repair-cost text) ──────────────────────
# "openai"  → GPT-4o for both vision and text (works immediately)
# "bedrock" → Qwen via AWS Bedrock (needs on-demand quota)
LLM_PROVIDER=openai

# ── AWS Bedrock — Qwen models ─────────────────────────────────────────────────
BEDROCK_VISION_MODEL_ID=qwen.qwen3-vl-235b-a22b
BEDROCK_COST_MODEL_ID=qwen.qwen3-32b-v1:0

# ── Damage detection (YOLO boxes / masks) ─────────────────────────────────────
# "huggingface" → Naiscorp/car-damage-detection, pretrained 7-class model.
#                 Use this until our own YOLOv8 is trained on CarDD via SageMaker.
# "yolo"        → our fine-tuned YOLOv8 weights (set YOLO_WEIGHTS below)
DAMAGE_DETECTOR=huggingface
HF_DAMAGE_MODEL=Naiscorp/car-damage-detection
DAMAGE_CONF_THRESHOLD=0.5

# Save an annotated overlay (boxes + masks + labels) for each analyzed image.
# Only works with the cardamage model (DAMAGE_DETECTOR=huggingface).
SAVE_ANNOTATED=false

# ── Analysis mode ─────────────────────────────────────────────────────────────
# "inline" — run vision + cost directly in ClaimLens (default, self-contained).
# "agents" — delegate to the Agentex multi-agent orchestrator. Requires the
#            Agentex stack + claim-analyzer agent to be running.
ANALYSIS_MODE=inline
AGENTEX_BASE_URL=http://localhost:5003
AGENTEX_AGENT_NAME=claim-analyzer

# ── AWS credentials ───────────────────────────────────────────────────────────
# Leave empty on ECS/SageMaker — IAM task role is used automatically
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── OpenAI (used when LLM_PROVIDER=openai) ────────────────────────────────────
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_COST_MODEL=gpt-4o

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" for development, "s3" for production
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=claimlens-images

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://claimlens:claimlens@localhost:5432/claimlens

# ── YOLOv8 ───────────────────────────────────────────────────────────────────
# Default: downloads pretrained yolov8n.pt on first run
# After SageMaker training: set to weights/damage_detector.pt
YOLO_WEIGHTS=yolov8n.pt
